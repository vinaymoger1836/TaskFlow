# =========================================================
# FREE API KEYS OPTIONS (Choose any ONE and create .env.local)
# =========================================================

# OPTION 1: Google Gemini (100% Free, No Credit Card Required)
# 1. Visit: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key" (Sign in with any standard Google account)
# 3. Paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OPTION 2: Groq (100% Free & Extremely Fast, No Credit Card Required)
# 1. Visit: https://console.groq.com/keys
# 2. Sign in with GitHub or Google and create a free key
# 3. Paste your key below:
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# OPTION 3: OpenRouter (Free models like llama-3.3, gemini-flash)
# 1. Visit: https://openrouter.ai/keys
# 2. Create a free key and paste below:
# OPENROUTER_API_KEY=sk-or-your_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OPTION 4: OpenAI (Paid)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
